{
  "manifest_version": 3,
  "name": "SponsorLens — Job Sponsorship Scanner",
  "version": "0.2.0",
  "description": "Scan job listings for visa sponsorship, work authorization, citizenship, export control, and security clearance language.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "SponsorLens",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib/analyzer.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
